    {
      "id": "RESULTADO_ESP_TRES",
      "title": "ESP-3 Visionario",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "escenario",
            "init-values": {
              "cantidad": "1"
            },
            "children": [
              {
                "type": "Dropdown",
                "name": "cantidad",
                "label": "Paquetes comprados en cada generación",
                "required": true,
                "data-source": [
                  {
                    "id": "1",
                    "title": "1 paquete"
                  },
                  {
                    "id": "3",
                    "title": "3 paquetes"
                  },
                  {
                    "id": "5",
                    "title": "5 paquetes"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '1'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 1 paquete\n$150 × 1 = $150\n\nGeneración 2 · 1 paquete\n$20 × 1 = $20\n\nGeneración 3 · 1 paquete\n$20 × 1 = $20\n\nGeneración 4 · 1 paquete\n$20 × 1 = $20\n\nGeneración 5 · 1 paquete\n$40 × 1 = $40"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Su bono por esas 5 compras: $250 USD"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '3'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 3 paquetes\n$150 × 3 = $450\n\nGeneración 2 · 3 paquetes\n$20 × 3 = $60\n\nGeneración 3 · 3 paquetes\n$20 × 3 = $60\n\nGeneración 4 · 3 paquetes\n$20 × 3 = $60\n\nGeneración 5 · 3 paquetes\n$40 × 3 = $120"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Su bono por esas 15 compras: $750 USD"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '5'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 5 paquetes\n$150 × 5 = $750\n\nGeneración 2 · 5 paquetes\n$20 × 5 = $100\n\nGeneración 3 · 5 paquetes\n$20 × 5 = $100\n\nGeneración 4 · 5 paquetes\n$20 × 5 = $100\n\nGeneración 5 · 5 paquetes\n$40 × 5 = $200"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Su bono por esas 25 compras: $1,250 USD"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Se liquida cada viernes, a medida que cada compra ocurre. No espera a que se complete nada."
              },
              {
                "type": "Footer",
                "label": "Listo",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "paquete": "ESP-3",
                    "cantidad": "${form.cantidad}"
                  }
                }
              },
              {
                "type": "TextCaption",
                "text": "Cada comisión se liquida por ciclos semanales y llega a su cuenta el segundo viernes después del cierre del ciclo."
              }
            ]
          }
        ]
      }
    },
