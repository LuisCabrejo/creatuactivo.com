    {
      "id": "RESULTADO_ESP_TRES",
      "title": "ESP-3 Visionario",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "escenario",
            "init-values": {
              "cantidad": "5"
            },
            "children": [
              {
                "type": "Dropdown",
                "name": "cantidad",
                "label": "Paquetes comprados en cada generación",
                "required": true,
                "data-source": [
                  {
                    "id": "1",
                    "title": "1 paquete"
                  },
                  {
                    "id": "3",
                    "title": "3 paquetes"
                  },
                  {
                    "id": "5",
                    "title": "5 paquetes"
                  },
                  {
                    "id": "10",
                    "title": "10 paquetes"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '1'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 1 paquete\n$675.000 × 1 = $675.000\n\nGeneración 2 · 1 paquete\n$90.000 × 1 = $90.000\n\nGeneración 3 · 1 paquete\n$90.000 × 1 = $90.000\n\nGeneración 4 · 1 paquete\n$90.000 × 1 = $90.000\n\nGeneración 5 · 1 paquete\n$180.000 × 1 = $180.000"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Total: $1.125.000 COP"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '3'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 3 paquetes\n$675.000 × 3 = $2.025.000\n\nGeneración 2 · 3 paquetes\n$90.000 × 3 = $270.000\n\nGeneración 3 · 3 paquetes\n$90.000 × 3 = $270.000\n\nGeneración 4 · 3 paquetes\n$90.000 × 3 = $270.000\n\nGeneración 5 · 3 paquetes\n$180.000 × 3 = $540.000"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Total: $3.375.000 COP"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '5'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 5 paquetes\n$675.000 × 5 = $3.375.000\n\nGeneración 2 · 5 paquetes\n$90.000 × 5 = $450.000\n\nGeneración 3 · 5 paquetes\n$90.000 × 5 = $450.000\n\nGeneración 4 · 5 paquetes\n$90.000 × 5 = $450.000\n\nGeneración 5 · 5 paquetes\n$180.000 × 5 = $900.000"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Total: $5.625.000 COP"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.cantidad} == '10'",
                "then": [
                  {
                    "type": "TextBody",
                    "text": "Generación 1 · 10 paquetes\n$675.000 × 10 = $6.750.000\n\nGeneración 2 · 10 paquetes\n$90.000 × 10 = $900.000\n\nGeneración 3 · 10 paquetes\n$90.000 × 10 = $900.000\n\nGeneración 4 · 10 paquetes\n$90.000 × 10 = $900.000\n\nGeneración 5 · 10 paquetes\n$180.000 × 10 = $1.800.000"
                  },
                  {
                    "type": "TextHeading",
                    "text": "Total: $11.250.000 COP"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Se liquida cada viernes, a medida que cada compra ocurre. No espera a que se complete nada."
              },
              {
                "type": "Footer",
                "label": "Listo",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "paquete": "ESP-3",
                    "cantidad": "${form.cantidad}"
                  }
                }
              }
            ]
          }
        ]
      }
