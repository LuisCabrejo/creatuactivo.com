            "type": "Form",
            "name": "renta",
            "init-values": {
              "clientes": "10"
            },
            "children": [
              {
                "type": "Dropdown",
                "name": "clientes",
                "label": "Clientes en cada centro de negocio",
                "required": true,
                "data-source": [
                  {
                    "id": "10",
                    "title": "10 clientes"
                  },
                  {
                    "id": "25",
                    "title": "25 clientes"
                  },
                  {
                    "id": "50",
                    "title": "50 clientes"
                  },
                  {
                    "id": "100",
                    "title": "100 clientes"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.clientes} == '10'",
                "then": [
                  {
                    "type": "TextHeading",
                    "text": "≈ $428.400 COP al mes"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.clientes} == '25'",
                "then": [
                  {
                    "type": "TextHeading",
                    "text": "≈ $1.071.000 COP al mes"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.clientes} == '50'",
                "then": [
                  {
                    "type": "TextHeading",
                    "text": "≈ $2.142.000 COP al mes"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.clientes} == '100'",
                "then": [
                  {
                    "type": "TextHeading",
                    "text": "≈ $4.284.000 COP al mes"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Consumo estándar: cada cliente compra una caja de Ganocafé a la semana. Se liquida cada viernes."
              },
              {
                "type": "Footer",
                "label": "Listo",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "tipo": "renta",
                    "tarifa": "ESP-3 Visionario — 17%",
                    "clientes": "${form.clientes}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
